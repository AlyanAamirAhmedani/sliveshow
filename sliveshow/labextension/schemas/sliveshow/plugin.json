{
  "jupyter.lab.shortcuts": [],
  "title": "sliveshow",
  "description": "sliveshow settings.",
  "type": "object",
  "properties": {
    "dummy": {
      "type": "boolean",
      "title": "Dummy",
      "description": "Placeholder",
      "default": false
    },
    "default_transition": {
      "title": "Default slide transition type",
      "type": "string",
      "enum": ["none", "slide", "fade", "zoom"],
      "enumNames": ["None", "Slide", "Fade", "Zoom"],
      "default": "slide"
    },
    "reveal_plugins": {
      "title": "Reveal.js plugins",
      "description": "Third-party Reveal.js plugins to load when a slideshow starts. Each entry gives the global variable the plugin registers (name), the URL of its script, optional stylesheet URL(s), and optional configuration merged into Reveal's config. A plugin that fails to load is reported in the browser console and skipped. Example: the chalkboard plugin below lets you annotate slides live — press B for the chalkboard and C for the notes canvas — and is disabled by default.",
      "type": "array",
      "default": [
        {
          "name": "RevealChalkboard",
          "script": "https://cdn.jsdelivr.net/npm/reveal.js-plugins@latest/chalkboard/plugin.js",
          "css": [
            "https://cdn.jsdelivr.net/npm/reveal.js-plugins@latest/chalkboard/style.css"
          ],
          "config": {
            "chalkboard": {
              "theme": "whiteboard"
            }
          },
          "enabled": false
        }
      ],
      "items": {
        "type": "object",
        "required": ["name", "script"],
        "properties": {
          "name": {
            "title": "Global name",
            "description": "The global variable the plugin registers, e.g. RevealChalkboard.",
            "type": "string"
          },
          "script": {
            "title": "Script URL",
            "description": "URL of the plugin script, e.g. a jsDelivr link or a file served by Jupyter.",
            "type": "string"
          },
          "css": {
            "title": "Stylesheet URL(s)",
            "description": "Optional stylesheet(s) the plugin needs.",
            "type": ["string", "array"],
            "items": { "type": "string" }
          },
          "config": {
            "title": "Reveal config",
            "description": "Merged into Reveal's configuration, e.g. { \"chalkboard\": { \"theme\": \"whiteboard\" } }.",
            "type": "object",
            "additionalProperties": true
          },
          "enabled": {
            "title": "Enabled",
            "description": "Set false to keep the entry but skip loading it.",
            "type": "boolean",
            "default": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "jupyter.lab.menus": {
    "main": [
      {
        "id": "slideshow-menu",
        "label": "Sliveshow",
        "rank": 80,
        "items": [
          {
            "command": "slideshow:start-first"
          },
          {
            "command": "slideshow:start-current"
          },
          {
            "command": "slideshow:exit"
          }
        ]
      }
    ]
  },
  "jupyter.lab.metadataforms": [
    {
      "id": "slideshow-metadata-form:plugin",
      "label": "Slideshow Tools",
      "uiSchema": {
        "ui:order": [
          "/slideshow/transition",
          "/slideshow/transition_out",
          "/slideshow/slide_dir",
          "/slideshow/transition_duration",
          "/slideshow/hide_code"
        ]
      },
      "metadataSchema": {
        "type": "object",
        "properties": {
          "/slideshow/transition": {
            "title": "Transition Type",
            "type": "string",
            "enum": ["", "none", "slide", "fade", "zoom"],
            "enumNames": ["Default", "None", "Slide", "Fade", "Zoom"],
            "default": ""
          },
          "/slideshow/transition_out": {
            "title": "Transition-out Type",
            "description": "Does not apply to fragments",
            "type": "string",
            "enum": ["", "none", "slide", "fade", "zoom"],
            "enumNames": ["Inherit", "None", "Slide", "Fade", "Zoom"],
            "default": ""
          },
          "/slideshow/transition_duration": {
            "title": "Transition Duration (seconds)",
            "description": "Default: 0.5 seconds",
            "type": "number",
            "minimum": 0
          },
          "/slideshow/hide_code": {
            "title": "Hide Code Cell",
            "type": "boolean",
            "default": false
          }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "properties": {
                    "/slideshow/transition": {
                      "const": "slide"
                    }
                  }
                },
                {
                  "properties": {
                    "/slideshow/transition_out": {
                      "const": "slide"
                    }
                  }
                }
              ]
            },
            "then": {
              "properties": {
                "/slideshow/slide_dir": {
                  "title": "Slide Direction",
                  "type": "string",
                  "enum": ["horizontal", "vertical"],
                  "enumNames": ["Horizontal", "Vertical"]
                }
              }
            }
          }
        ]
      },
      "metadataOptions": {
        "/slideshow/hide_code": {
          "cellTypes": ["code"]
        }
      }
    }
  ]
}
